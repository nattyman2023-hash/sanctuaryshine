---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="CRM"
  description="Private Sanctuary Shine customer relationship dashboard."
  noIndex={true}
  manifest="/crm-manifest.webmanifest?v=2"
  themeColor="#00C2D1"
  hideChrome={true}
>
  <Header />
  <section class="crm-shell w-full max-w-full min-h-[calc(100vh-5rem)] bg-[#F3F7F8] py-6 md:py-14">
    <div class="w-full min-w-0 max-w-[1200px] mx-auto px-3 sm:px-4 md:px-6">
      <button id="crm-install-button" type="button" class="hidden max-w-md mx-auto mb-4 items-center justify-center gap-2 w-full bg-[#0B0B0B] text-white py-3 rounded-lg font-bold hover:bg-[#3C494C] transition-colors">
        Install app on this phone
      </button>

      <div id="crm-login-panel" class="max-w-md mx-auto bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-8">
        <img src="/images/logo/logo.png" alt="Sanctuary Shine" class="w-24 h-24 object-contain mb-3" />
        <p class="text-xs uppercase tracking-[0.2em] font-semibold text-[#008C99] mb-2">Sanctuary Shine</p>
        <h1 class="font-heading text-3xl font-bold text-[#0B0B0B] mb-3">CRM dashboard</h1>
        <p class="text-sm text-[#3C494C] mb-6">Sign in to view bookings, quote requests and website enquiries.</p>
        <form id="crm-login-form" class="space-y-4">
          <label class="block text-sm font-medium text-[#0B0B0B]" for="crm-email">Business email</label>
          <input id="crm-email" name="email" type="email" value={SITE.email} autocomplete="username" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#00C2D1] focus:ring-2 focus:ring-[#00C2D1]/20 outline-none" />
          <label class="block text-sm font-medium text-[#0B0B0B]" for="crm-password">CRM password</label>
          <div class="flex gap-2"><input id="crm-password" name="password" type="password" autocomplete="current-password" required class="min-w-0 flex-1 px-4 py-3 rounded-lg border border-gray-200 focus:border-[#00C2D1] focus:ring-2 focus:ring-[#00C2D1]/20 outline-none" /><button type="button" data-password-toggle="crm-password" class="px-3 rounded-lg border border-gray-200 text-xs font-semibold">Show</button></div>
          <button type="submit" class="w-full bg-[#FFD200] text-[#0B0B0B] py-3 rounded-lg font-bold hover:bg-[#D6A900] transition-colors">Sign in</button>
          <p id="crm-login-message" class="text-sm text-red-600 min-h-5" role="alert"></p>
        </form>
        <p class="text-sm text-center mt-2"><button type="button" id="crm-forgot-link" class="text-[#008C99] font-semibold hover:underline">Forgot password?</button></p>
      </div>

      <div id="crm-forgot-panel" class="hidden max-w-md mx-auto bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-8">
        <h1 class="font-heading text-2xl font-bold text-[#0B0B0B] mb-3">Reset your password</h1>
        <p class="text-sm text-[#3C494C] mb-6">Enter your CRM email address and we'll send you a link to set a new password.</p>
        <form id="crm-forgot-form" class="space-y-4">
          <label class="block text-sm font-medium text-[#0B0B0B]" for="crm-forgot-email">Business email</label>
          <input id="crm-forgot-email" type="email" autocomplete="username" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#00C2D1] focus:ring-2 focus:ring-[#00C2D1]/20 outline-none" />
          <button type="submit" class="w-full bg-[#FFD200] text-[#0B0B0B] py-3 rounded-lg font-bold hover:bg-[#D6A900] transition-colors">Send reset link</button>
          <p id="crm-forgot-message" class="text-sm min-h-5" role="alert"></p>
        </form>
        <p class="text-sm text-center mt-2"><button type="button" id="crm-forgot-back" class="text-[#008C99] font-semibold hover:underline">Back to sign in</button></p>
      </div>

      <div id="crm-reset-panel" class="hidden max-w-md mx-auto bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-8">
        <h1 class="font-heading text-2xl font-bold text-[#0B0B0B] mb-3">Set a new password</h1>
        <p class="text-sm text-[#3C494C] mb-6">Choose a new password for your CRM account. It must be at least 10 characters.</p>
        <form id="crm-reset-form" class="space-y-4">
          <div><label for="crm-reset-new-password" class="block text-sm font-medium text-[#0B0B0B] mb-1">New password</label><div class="flex gap-2"><input id="crm-reset-new-password" type="password" minlength="10" required class="min-w-0 flex-1 px-4 py-3 rounded-lg border border-gray-200 focus:border-[#00C2D1] focus:ring-2 focus:ring-[#00C2D1]/20 outline-none" /><button type="button" data-password-toggle="crm-reset-new-password" class="px-3 rounded-lg border border-gray-200 text-xs font-semibold">Show</button></div></div>
          <div><label for="crm-reset-confirm-password" class="block text-sm font-medium text-[#0B0B0B] mb-1">Confirm new password</label><input id="crm-reset-confirm-password" type="password" minlength="10" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#00C2D1] focus:ring-2 focus:ring-[#00C2D1]/20 outline-none" /></div>
          <button type="submit" class="w-full bg-[#FFD200] text-[#0B0B0B] py-3 rounded-lg font-bold hover:bg-[#D6A900] transition-colors">Set new password</button>
          <p id="crm-reset-message" class="text-sm min-h-5" role="alert"></p>
        </form>
      </div>

      <div id="crm-dashboard" class="hidden">
        <div class="crm-dashboard-heading flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 md:mb-8">
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-[0.2em] font-semibold text-[#008C99] mb-2">Private workspace</p>
            <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-[#0B0B0B]">Bookings & enquiries</h1>
            <p class="text-sm sm:text-base text-[#3C494C] mt-2">Keep every request in one place and move it through your pipeline.</p>
            <p id="crm-logged-in-badge" class="hidden items-center gap-2 mt-3 text-sm font-semibold text-[#0B7A3C]">
              <span class="w-2 h-2 rounded-full bg-[#0B7A3C]"></span>
              <span>Logged in as <span id="crm-logged-in-name"></span></span>
            </p>
          </div>
          <div class="crm-dashboard-actions grid grid-cols-2 sm:flex sm:flex-wrap gap-2 sm:gap-3 w-full md:w-auto">
            <button id="crm-invoice-toggle" type="button" class="hidden min-h-11 px-3 sm:px-4 py-2.5 rounded-lg bg-[#00C2D1] text-white text-sm font-semibold hover:bg-[#008C99] transition-colors">Invoices</button>
            <button id="crm-account-toggle" type="button" class="min-h-11 px-3 sm:px-4 py-2.5 rounded-lg border border-gray-200 bg-white text-sm font-semibold hover:border-[#00C2D1] transition-colors">Account & access</button>
            <button id="crm-export" type="button" class="min-h-11 px-3 sm:px-4 py-2.5 rounded-lg border border-gray-200 bg-white text-sm font-semibold hover:border-[#00C2D1] transition-colors">Export CSV</button>
            <button id="crm-logout" type="button" class="min-h-11 px-3 sm:px-4 py-2.5 rounded-lg bg-[#0B0B0B] text-white text-sm font-semibold hover:bg-[#3C494C] transition-colors">Sign out</button>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 mb-5 md:mb-6">
          <div class="bg-white rounded-xl border border-gray-100 p-3 sm:p-5 shadow-sm"><p class="text-[10px] sm:text-xs uppercase tracking-wider text-[#6C797C]">All leads</p><p id="stat-total" class="font-heading text-2xl sm:text-3xl font-bold mt-1 sm:mt-2">0</p></div>
          <div class="bg-white rounded-xl border border-gray-100 p-3 sm:p-5 shadow-sm"><p class="text-[10px] sm:text-xs uppercase tracking-wider text-[#6C797C]">New</p><p id="stat-new" class="font-heading text-2xl sm:text-3xl font-bold mt-1 sm:mt-2 text-[#008C99]">0</p></div>
          <div class="bg-white rounded-xl border border-gray-100 p-3 sm:p-5 shadow-sm"><p class="text-[10px] sm:text-xs uppercase tracking-wider text-[#6C797C]">Bookings</p><p id="stat-bookings" class="font-heading text-2xl sm:text-3xl font-bold mt-1 sm:mt-2">0</p></div>
          <div class="bg-white rounded-xl border border-gray-100 p-3 sm:p-5 shadow-sm"><p class="text-[10px] sm:text-xs uppercase tracking-wider text-[#6C797C]">Quote requests</p><p id="stat-quotes" class="font-heading text-2xl sm:text-3xl font-bold mt-1 sm:mt-2">0</p></div>
        </div>

        <div id="crm-account-panel" class="hidden mt-5 md:mt-6 grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">
          <div class="bg-white rounded-xl sm:rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-6">
            <p class="text-xs uppercase tracking-wider text-[#008C99] font-semibold">My account</p>
            <h2 id="crm-current-user" class="font-heading text-2xl font-bold mt-2"></h2>
            <p class="text-sm text-[#6C797C] mt-1">Stored passwords are never displayed. Use Show to reveal a password while you are typing or set a new one for a team member.</p>
            <form id="crm-password-form" class="space-y-3 mt-5">
              <div><label for="crm-current-password" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Current password</label><div class="flex gap-2"><input id="crm-current-password" type="password" required class="min-w-0 flex-1 px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /><button type="button" data-password-toggle="crm-current-password" class="px-3 rounded-lg border border-gray-200 text-xs font-semibold">Show</button></div></div>
              <div><label for="crm-new-password" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">New password</label><div class="flex gap-2"><input id="crm-new-password" type="password" minlength="10" required class="min-w-0 flex-1 px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /><button type="button" data-password-toggle="crm-new-password" class="px-3 rounded-lg border border-gray-200 text-xs font-semibold">Show</button></div></div>
              <div><label for="crm-confirm-password" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Confirm new password</label><input id="crm-confirm-password" type="password" minlength="10" required class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
              <button type="submit" class="px-4 py-2.5 rounded-lg bg-[#00C2D1] text-white text-sm font-bold hover:bg-[#008C99]">Change password</button>
              <p id="crm-password-message" class="text-sm min-h-5" role="alert"></p>
            </form>
          </div>

          <div id="crm-user-management" class="hidden bg-white rounded-xl sm:rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-6">
            <p class="text-xs uppercase tracking-wider text-[#008C99] font-semibold">Administrator access</p>
            <h2 class="font-heading text-2xl font-bold mt-2">CRM users</h2>
            <p class="text-sm text-[#6C797C] mt-1">Add team members and choose exactly what each account can access.</p>
            <form id="crm-create-user-form" class="space-y-3 mt-5">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3"><input id="crm-new-user-name" type="text" placeholder="Full name" required class="px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /><input id="crm-new-user-email" type="email" placeholder="Email address" required class="px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
              <div class="flex gap-2"><input id="crm-new-user-password" type="password" minlength="10" placeholder="Temporary password (10+ characters)" required class="min-w-0 flex-1 px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /><button type="button" data-password-toggle="crm-new-user-password" class="px-3 rounded-lg border border-gray-200 text-xs font-semibold">Show</button></div>
              <div class="grid grid-cols-2 gap-2 text-sm">
                <label class="flex items-center gap-2"><input type="checkbox" data-create-feature="view_leads" checked /> View leads</label>
                <label class="flex items-center gap-2"><input type="checkbox" data-create-feature="edit_leads" /> Edit leads</label>
                <label class="flex items-center gap-2"><input type="checkbox" data-create-feature="export_leads" /> Export CSV</label>
                <label class="flex items-center gap-2"><input type="checkbox" data-create-feature="manage_users" /> Manage users</label>
                <label class="flex items-center gap-2"><input type="checkbox" data-create-feature="manage_invoices" /> Manage invoices</label>
              </div>
              <button type="submit" class="px-4 py-2.5 rounded-lg bg-[#FFD200] text-[#0B0B0B] text-sm font-bold hover:bg-[#D6A900]">Add user</button>
              <p id="crm-user-message" class="text-sm min-h-5" role="alert"></p>
            </form>
            <div id="crm-users-list" class="space-y-3 mt-6"></div>
          </div>
        </div>

        <section id="crm-invoice-panel" class="hidden mt-5 md:mt-6 space-y-4 sm:space-y-6">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-[0.2em] font-semibold text-[#008C99] mb-2">Billing workspace</p>
              <h2 class="font-heading text-2xl sm:text-3xl font-bold text-[#0B0B0B]">Invoices</h2>
              <p class="text-sm sm:text-base text-[#3C494C] mt-2">Create branded invoices, save them to the CRM and send the customer a payment-ready summary.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 w-full md:w-auto"><button id="crm-invoice-saved" type="button" class="min-h-11 px-4 py-2.5 rounded-lg border border-gray-200 bg-white text-sm font-semibold hover:border-[#00C2D1] transition-colors">Saved invoices</button><button id="crm-invoice-new" type="button" class="min-h-11 px-4 py-2.5 rounded-lg border border-gray-200 bg-white text-sm font-semibold hover:border-[#00C2D1] transition-colors">New invoice</button></div>
          </div>

          <div class="grid grid-cols-1 2xl:grid-cols-2 gap-4 sm:gap-6 items-start min-w-0">
            <div class="min-w-0 bg-white rounded-xl sm:rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-6">
              <form id="crm-invoice-form" class="space-y-5">
                <input id="crm-invoice-id" type="hidden" />
                <div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="text-xs uppercase tracking-wider text-[#6C797C]">Invoice details</p><h3 class="font-heading text-lg sm:text-xl font-bold mt-1">Customer and payment</h3></div><span id="crm-invoice-status" class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full bg-[#F2F4F5] text-[#6C797C]">Draft</span></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div><label for="crm-invoice-lead" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Fill from lead</label><select id="crm-invoice-lead" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 bg-white text-sm"><option value="">Choose a CRM lead...</option></select></div>
                  <div><label for="crm-invoice-number" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Invoice number</label><input id="crm-invoice-number" type="text" required class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
                  <div><label for="crm-invoice-issue-date" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Issue date</label><input id="crm-invoice-issue-date" type="date" required class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
                  <div><label for="crm-invoice-due-date" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Due date</label><input id="crm-invoice-due-date" type="date" required class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
                  <div><label for="crm-invoice-service-date" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Service date</label><input id="crm-invoice-service-date" type="date" class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
                  <div><label for="crm-invoice-payment-link" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Payment link <span class="normal-case tracking-normal font-normal">(Stripe/PayPal)</span></label><input id="crm-invoice-payment-link" type="url" placeholder="https://..." class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /></div>
                </div>

                <div class="border-t border-gray-100 pt-5"><p class="text-xs uppercase tracking-wider text-[#6C797C] mb-3">Bill to</p><div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <input id="crm-invoice-customer-name" type="text" placeholder="Customer name" required class="px-3 py-2.5 rounded-lg border border-gray-200 text-sm" />
                  <input id="crm-invoice-customer-email" type="email" placeholder="Customer email" required class="px-3 py-2.5 rounded-lg border border-gray-200 text-sm" />
                  <input id="crm-invoice-customer-phone" type="tel" placeholder="Phone" class="px-3 py-2.5 rounded-lg border border-gray-200 text-sm" />
                  <input id="crm-invoice-customer-postcode" type="text" placeholder="Postcode" class="px-3 py-2.5 rounded-lg border border-gray-200 text-sm" />
                  <textarea id="crm-invoice-customer-address" rows="2" placeholder="Billing address" class="md:col-span-2 px-3 py-2.5 rounded-lg border border-gray-200 text-sm"></textarea>
                </div></div>

                <div class="border-t border-gray-100 pt-5"><div class="flex items-center justify-between gap-3 mb-3"><p class="text-xs uppercase tracking-wider text-[#6C797C]">Services</p><button id="crm-invoice-add-item" type="button" class="text-xs font-bold text-[#008C99] hover:underline">+ Add line</button></div><div id="crm-invoice-items" class="space-y-2"></div></div>
                <div><label for="crm-invoice-notes" class="block text-xs uppercase tracking-wider text-[#6C797C] mb-1">Customer note</label><textarea id="crm-invoice-notes" rows="3" placeholder="Thank you for choosing Sanctuary Shine..." class="w-full px-3 py-2.5 rounded-lg border border-gray-200 text-sm"></textarea></div>
                <div class="rounded-xl bg-[#F8FAFB] border border-gray-100 p-4 text-xs text-[#3C494C]"><p class="font-semibold text-[#0B0B0B] mb-1">Bank transfer details included automatically</p><p>SANCTUARY SHINE LTD · Sort code 04-00-06 · IBAN GB19 MONZ 0400 0608 0401 69 · Company no. 08040169</p></div>
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:flex gap-2 pt-1"><button id="crm-invoice-save" type="submit" class="min-h-11 px-4 py-2.5 rounded-lg bg-[#FFD200] text-[#0B0B0B] text-sm font-bold hover:bg-[#D6A900]">Save invoice</button><button id="crm-invoice-pdf" type="button" class="min-h-11 px-4 py-2.5 rounded-lg bg-[#0B0B0B] text-white text-sm font-bold hover:bg-[#3C494C]">Print / save PDF</button><button id="crm-invoice-send" type="button" class="min-h-11 px-4 py-2.5 rounded-lg border border-[#00C2D1] text-[#008C99] text-sm font-bold hover:bg-[#D9FBFF]">Send to customer</button><button id="crm-invoice-share" type="button" class="min-h-11 px-4 py-2.5 rounded-lg border border-gray-200 text-[#3C494C] text-sm font-semibold hover:border-[#00C2D1]">Share payment link</button></div>
                <p id="crm-invoice-message" class="text-sm min-h-5" role="alert"></p>
              </form>
            </div>

            <div class="min-w-0 space-y-6 2xl:sticky 2xl:top-6">
              <div class="min-w-0 max-w-full bg-[#EAF7F8] rounded-xl sm:rounded-2xl border border-[#CFECEF] p-2 sm:p-3 md:p-5"><div id="crm-invoice-preview" class="min-w-0 max-w-full bg-white rounded-xl shadow-sm overflow-hidden"></div></div>
              <div id="crm-saved-invoices" class="bg-white rounded-xl sm:rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-6"><div class="flex items-start justify-between gap-3 mb-4"><div><p class="text-xs uppercase tracking-wider text-[#6C797C]">Saved invoices</p><h3 class="font-heading text-lg sm:text-xl font-bold mt-1">Recent billing</h3><p class="text-xs text-[#6C797C] mt-1">Tap any saved invoice to reopen and edit it later.</p></div><span id="crm-invoice-count" class="shrink-0 text-xs text-[#6C797C]"></span></div><div id="crm-invoice-list" class="space-y-3"><p class="text-sm text-[#6C797C]">Invoices you save will appear here.</p></div></div>
            </div>
          </div>
        </section>

        <div class="bg-white rounded-xl sm:rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <div class="p-4 sm:p-5 border-b border-gray-100 flex flex-col gap-3">
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0"><h2 class="font-heading text-lg sm:text-xl font-bold">Lead pipeline</h2><p id="crm-lead-load-status" class="text-xs text-[#6C797C] mt-1" aria-live="polite">Loading leads...</p></div>
              <button id="crm-refresh-leads" type="button" class="shrink-0 min-h-10 px-3 rounded-lg border border-[#00C2D1] text-[#008C99] text-xs sm:text-sm font-semibold hover:bg-[#D9FBFF]">Refresh leads</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto_auto_auto] gap-2 sm:gap-3">
              <input id="crm-search" type="search" autocomplete="off" placeholder="Search name, email or postcode" class="min-h-11 w-full min-w-0 px-3 py-2 rounded-lg border border-gray-200 text-sm focus:border-[#00C2D1] outline-none" />
              <select id="crm-type" autocomplete="off" class="min-h-11 w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:border-[#00C2D1] outline-none bg-white">
                <option value="all">All types</option>
                <option value="booking">Bookings</option>
                <option value="quote">Quotes</option>
                <option value="inquiry">Enquiries</option>
              </select>
              <select id="crm-status" autocomplete="off" class="min-h-11 w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:border-[#00C2D1] outline-none bg-white">
                <option value="all">All statuses</option>
                <option value="new">New</option>
                <option value="contacted">Contacted</option>
                <option value="quoted">Quoted</option>
                <option value="booked">Booked</option>
                <option value="completed">Completed</option>
                <option value="closed">Closed</option>
              </select>
              <button id="crm-reset-lead-filters" type="button" class="min-h-11 px-3 rounded-lg border border-gray-200 text-[#3C494C] text-sm font-semibold hover:border-[#00C2D1]">Reset</button>
            </div>
          </div>

