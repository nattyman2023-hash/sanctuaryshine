<script>
  const api = '/crm-api.php';
  const loginPanel = document.getElementById('crm-login-panel');
  const dashboard = document.getElementById('crm-dashboard');
  const loginForm = document.getElementById('crm-login-form');
  const loginMessage = document.getElementById('crm-login-message');
  const forgotPanel = document.getElementById('crm-forgot-panel');
  const forgotForm = document.getElementById('crm-forgot-form');
  const resetPanel = document.getElementById('crm-reset-panel');
  const resetForm = document.getElementById('crm-reset-form');
  const leadsBody = document.getElementById('crm-leads-body');
  const leadsCards = document.getElementById('crm-leads-cards');
  const emptyState = document.getElementById('crm-empty');
  const errorBox = document.getElementById('crm-error');
  const leadLoadStatus = document.getElementById('crm-lead-load-status');
  const refreshLeadsButton = document.getElementById('crm-refresh-leads');
  const detail = document.getElementById('crm-detail');
  const accountToggle = document.getElementById('crm-account-toggle');
  const accountPanel = document.getElementById('crm-account-panel');
  const userManagement = document.getElementById('crm-user-management');
  const usersList = document.getElementById('crm-users-list');
  const invoiceToggle = document.getElementById('crm-invoice-toggle');
  const invoicePanel = document.getElementById('crm-invoice-panel');
  const savedInvoicesPanel = document.getElementById('crm-saved-invoices');
  const invoiceForm = document.getElementById('crm-invoice-form');
  const invoicePreview = document.getElementById('crm-invoice-preview');
  const invoiceItems = document.getElementById('crm-invoice-items');
  const invoiceList = document.getElementById('crm-invoice-list');
  let leads = [];
  let invoices = [];
  let selectedLead = null;
  let currentUser = null;
  let dashboardLoadPromise = null;
  let dashboardReady = false;
  let leadsLoaded = false;

  const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character]));
  const label = (value) => String(value || '').replace(/(^|_)([a-z])/g, (_, prefix, character) => `${prefix ? ' ' : ''}${character.toUpperCase()}`);
  const validDate = (value) => {
    if (!value) return null;
    const date = new Date(String(value).trim());
    return Number.isNaN(date.getTime()) ? null : date;
  };
  const formatDate = (value) => {
    const date = validDate(value);
    return date ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' }).format(date) : 'Not provided';
  };
  const formatDateTime = (value) => {
    const date = validDate(value);
    return date ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short' }).format(date) : 'Not provided';
  };

  const formatMoney = (value) => `£${Number(value || 0).toFixed(2)}`;
  const formatInvoiceDate = (value) => {
    const date = validDate(value ? `${value}T00:00:00` : '');
    return date ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' }).format(date) : 'Not set';
  };
  const safePaymentLink = (value) => /^https?:\/\//i.test(String(value || '')) ? String(value) : '';
  const today = () => new Date().toISOString().slice(0, 10);
  const addDays = (date, days) => { const next = validDate(date ? `${date}T00:00:00` : '') || validDate(today()); next.setDate(next.getDate() + days); return next.toISOString().slice(0, 10); };

  const featureLabels = { view_leads: 'View leads', edit_leads: 'Edit leads', export_leads: 'Export CSV', manage_users: 'Manage users', manage_invoices: 'Manage invoices' };
  const invoiceCompany = {
    name: 'Sanctuary Shine Ltd',
    companyNumber: '08040169',
    email: 'contact@sanctuaryshine.co.uk',
    phone: '0161 123 4567',
    address: '13 Moorsholme Ave, Manchester, M40 9BW',
    accountName: 'SANCTUARY SHINE LTD',
    sortCode: '04-00-06',
    iban: 'GB19 MONZ 0400 0608 0401 69',
  };

  async function request(action, options = {}) {
    const requestUrl = new URL(api, window.location.origin);
    requestUrl.searchParams.set('action', action);
    requestUrl.searchParams.set('_', String(Date.now()));
    const response = await fetch(requestUrl.toString(), { ...options, cache: 'no-store' });
    const contentType = response.headers.get('content-type') || '';
    const result = contentType.includes('application/json') ? await response.json() : await response.text();
    if (!response.ok) throw new Error(result?.message || 'The CRM request failed.');
    return result;
  }

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
  }

  function hasFeature(feature) {
    return Boolean(currentUser && Array.isArray(currentUser.features) && currentUser.features.includes(feature));
  }

  function renderUsers(users) {
    usersList.innerHTML = users.map((user) => `
      <div class="rounded-xl border border-gray-100 bg-[#F8FAFB] p-4" data-crm-user-id="${escapeHtml(user.id)}">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <input data-user-name type="text" value="${escapeHtml(user.name)}" class="px-3 py-2 rounded-lg border border-gray-200 text-sm" />
          <input data-user-email type="email" value="${escapeHtml(user.email)}" class="px-3 py-2 rounded-lg border border-gray-200 text-sm" />
        </div>
        <div class="flex items-center gap-3 mt-3 text-sm"><label class="flex items-center gap-2"><input data-user-active type="checkbox" ${user.active ? 'checked' : ''} ${currentUser && currentUser.id === user.id ? 'disabled' : ''} /> Active</label><span class="text-[#6C797C]">${escapeHtml(label(user.role))}</span></div>
        <div class="grid grid-cols-2 gap-2 mt-3 text-sm">${Object.entries(featureLabels).map(([feature, featureLabel]) => `<label class="flex items-center gap-2"><input type="checkbox" data-user-feature="${feature}" ${user.features.includes(feature) ? 'checked' : ''} /> ${featureLabel}</label>`).join('')}</div>
        <div class="flex flex-col sm:flex-row gap-2 mt-3"><div class="flex min-w-0 flex-1 gap-2"><input id="crm-user-password-${escapeHtml(user.id)}" data-user-password type="password" placeholder="New password (leave blank to keep)" class="min-w-0 flex-1 px-3 py-2 rounded-lg border border-gray-200 text-sm" /><button type="button" data-password-toggle="crm-user-password-${escapeHtml(user.id)}" class="px-3 rounded-lg border border-gray-200 text-xs font-semibold">Show</button></div><button type="button" data-user-save class="px-4 py-2 rounded-lg bg-[#00C2D1] text-white text-sm font-bold hover:bg-[#008C99]">Save user</button><button type="button" data-user-delete class="px-4 py-2 rounded-lg border border-red-200 text-red-600 text-sm font-semibold hover:bg-red-50">Remove</button></div>
      </div>`).join('');
  }

  function addInvoiceItemRow(item = {}) {
    const row = document.createElement('div');
    row.className = 'grid grid-cols-2 sm:grid-cols-[minmax(0,1fr)_72px_100px_32px] gap-2 items-center';
    row.dataset.invoiceItem = 'true';
    row.innerHTML = `<input data-item-description type="text" value="${escapeHtml(item.description || '')}" placeholder="Service description" required class="min-w-0 px-3 py-2.5 rounded-lg border border-gray-200 text-sm" /><input data-item-quantity type="number" min="0.01" step="0.01" value="${item.quantity || 1}" aria-label="Quantity" class="w-full px-2 py-2.5 rounded-lg border border-gray-200 text-sm" /><input data-item-price type="number" min="0" step="0.01" value="${item.unit_price ?? ''}" placeholder="£0.00" aria-label="Unit price" class="w-full px-2 py-2.5 rounded-lg border border-gray-200 text-sm" /><button type="button" data-remove-invoice-item aria-label="Remove line" class="w-8 h-8 rounded-lg text-[#6C797C] hover:bg-red-50 hover:text-red-600">×</button>`;
    invoiceItems.appendChild(row);
    row.querySelector('[data-item-description]').classList.add('col-span-2', 'sm:col-span-1', 'w-full');
    row.querySelector('[data-remove-invoice-item]').classList.add('col-span-2', 'sm:col-span-1', 'justify-self-end');
    row.querySelectorAll('input').forEach((input) => input.addEventListener('input', renderInvoicePreview));
  }

  function invoiceItemsFromForm() {
    return Array.from(invoiceItems.querySelectorAll('[data-invoice-item]')).map((row) => ({
      description: row.querySelector('[data-item-description]')?.value.trim() || '',
      quantity: Number(row.querySelector('[data-item-quantity]')?.value || 0),
      unit_price: Number(row.querySelector('[data-item-price]')?.value || 0),
    })).filter((item) => item.description && item.quantity > 0);
  }

  function getInvoiceFromForm() {
    const status = document.getElementById('crm-invoice-status').textContent.trim().toLowerCase();
    return {
      id: document.getElementById('crm-invoice-id').value,
      invoice_number: document.getElementById('crm-invoice-number').value.trim(),
      issue_date: document.getElementById('crm-invoice-issue-date').value,
      due_date: document.getElementById('crm-invoice-due-date').value,
      service_date: document.getElementById('crm-invoice-service-date').value,
      customer: {
        name: document.getElementById('crm-invoice-customer-name').value.trim(),
        email: document.getElementById('crm-invoice-customer-email').value.trim(),
        phone: document.getElementById('crm-invoice-customer-phone').value.trim(),
        address: document.getElementById('crm-invoice-customer-address').value.trim(),
        postcode: document.getElementById('crm-invoice-customer-postcode').value.trim(),
      },
      line_items: invoiceItemsFromForm(),
      payment_link: document.getElementById('crm-invoice-payment-link').value.trim(),
      notes: document.getElementById('crm-invoice-notes').value.trim(),
      status: ['draft', 'sent', 'paid'].includes(status) ? status : 'draft',
    };
  }

  function invoiceTotal(invoice) {
    return (invoice.line_items || []).reduce((total, item) => total + (Number(item.quantity || 0) * Number(item.unit_price || 0)), 0);
  }

  function setInvoiceStatus(status) {
    const badge = document.getElementById('crm-invoice-status');
    const normalized = status || 'draft';
    badge.textContent = label(normalized);
    badge.className = `text-xs font-semibold px-2.5 py-1 rounded-full ${normalized === 'paid' ? 'bg-green-100 text-green-700' : normalized === 'sent' ? 'bg-[#D9FBFF] text-[#008C99]' : 'bg-[#F2F4F5] text-[#6C797C]'}`;
  }

  function invoiceMarkup(invoice) {
    const customer = invoice.customer || {};
    const rows = (invoice.line_items || []).map((item) => `<tr><td>${escapeHtml(item.description)}</td><td class="align-top text-right">${Number(item.quantity || 0).toFixed(2).replace('.00', '')}</td><td class="align-top text-right">${formatMoney(item.unit_price)}</td><td class="align-top text-right font-semibold">${formatMoney(Number(item.quantity || 0) * Number(item.unit_price || 0))}</td></tr>`).join('');
    const paymentUrl = safePaymentLink(invoice.payment_link);
    const paymentLink = paymentUrl ? `<a class="invoice-payment-link" href="${escapeHtml(paymentUrl)}">Pay securely online</a>` : '<span class="muted">Payment link not added</span>';
    return `<article class="invoice-sheet"><header class="invoice-header"><div><img src="/images/logo/logo.png" alt="Sanctuary Shine" class="invoice-logo" /><p class="invoice-company">${escapeHtml(invoiceCompany.address)}<br />${escapeHtml(invoiceCompany.phone)} - ${escapeHtml(invoiceCompany.email)}</p></div><div class="invoice-title"><p class="eyebrow">Invoice</p><h1>${escapeHtml(invoice.invoice_number || 'Draft invoice')}</h1><p class="muted">Issued ${escapeHtml(formatInvoiceDate(invoice.issue_date))}</p><p class="muted">Due ${escapeHtml(formatInvoiceDate(invoice.due_date))}</p></div></header><div class="invoice-rule"></div><section class="invoice-parties"><div><p class="eyebrow">From</p><p class="party-name">${escapeHtml(invoiceCompany.name)}</p><p>${escapeHtml(invoiceCompany.address)}</p><p>Company no. ${escapeHtml(invoiceCompany.companyNumber)}</p></div><div><p class="eyebrow">Bill to</p><p class="party-name">${escapeHtml(customer.name || 'Customer name')}</p><p>${escapeHtml(customer.email || '')}</p><p>${escapeHtml(customer.phone || '')}</p><p>${escapeHtml(customer.address || '')}${customer.postcode ? `<br />${escapeHtml(customer.postcode)}` : ''}</p></div></section><table class="invoice-table"><thead><tr><th>Description</th><th class="text-right">Qty</th><th class="text-right">Rate</th><th class="text-right">Amount</th></tr></thead><tbody>${rows || '<tr><td colspan="4" class="muted">Add a service line to preview the invoice.</td></tr>'}</tbody></table><div class="invoice-total"><span>Total due</span><strong>${formatMoney(invoiceTotal(invoice))}</strong></div><section class="invoice-payment"><div><p class="eyebrow">Payment details</p><p><strong>${escapeHtml(invoiceCompany.accountName)}</strong><br />Sort code ${escapeHtml(invoiceCompany.sortCode)}<br />IBAN ${escapeHtml(invoiceCompany.iban)}<br />Company no. ${escapeHtml(invoiceCompany.companyNumber)}</p></div><div><p class="eyebrow">Online payment</p><p>${paymentLink}</p></div></section>${invoice.service_date ? `<p class="invoice-note"><strong>Service date:</strong> ${escapeHtml(formatInvoiceDate(invoice.service_date))}</p>` : ''}${invoice.notes ? `<p class="invoice-note">${escapeHtml(invoice.notes)}</p>` : ''}<footer class="invoice-footer">Thank you for choosing Sanctuary Shine.</footer></article>`;
  }

  function renderInvoicePreview() {
    invoicePreview.innerHTML = invoiceMarkup(getInvoiceFromForm());
  }

  const invoicePrintStyles = `<style>@page{size:A4;margin:14mm}*{box-sizing:border-box}body{margin:0;background:#fff;color:#191c1d;font-family:Arial,sans-serif;font-size:12px}.invoice-sheet{max-width:780px;margin:0 auto;padding:16px}.invoice-header,.invoice-parties,.invoice-payment{display:flex;justify-content:space-between;gap:36px}.invoice-header{align-items:flex-start}.invoice-logo{width:175px;height:120px;object-fit:contain;object-position:left center}.invoice-company{color:#6c797c;line-height:1.55;margin-top:2px}.invoice-title{text-align:right}.invoice-title h1{font-size:28px;margin:5px 0 10px;color:#0b0b0b}.eyebrow{color:#008c99;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin:0 0 7px}.muted{color:#6c797c}.invoice-rule{border-top:4px solid #00c2d1;margin:22px 0}.invoice-parties{margin:0 0 28px}.invoice-parties>div,.invoice-payment>div{flex:1}.party-name{font-weight:700;font-size:15px;margin:0 0 4px}.invoice-parties p,.invoice-payment p{margin:3px 0;line-height:1.45}.invoice-table{width:100%;border-collapse:collapse;margin-top:6px}.invoice-table th{background:#f2f4f5;color:#3c494c;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.invoice-table th,.invoice-table td{padding:11px 10px;border-bottom:1px solid #e6e8e9}.text-right{text-align:right}.invoice-total{display:flex;justify-content:flex-end;align-items:center;gap:35px;padding:18px 10px;font-size:14px}.invoice-total strong{font-size:24px;color:#008c99}.invoice-payment{background:#f8fafb;border:1px solid #e6e8e9;border-radius:10px;padding:15px 17px;margin-top:5px}.invoice-payment-link{color:#008c99;font-weight:700;text-decoration:none}.invoice-note{border-left:3px solid #ffd200;padding-left:10px;line-height:1.5;margin:20px 0 0}.invoice-footer{border-top:1px solid #e6e8e9;color:#6c797c;margin-top:34px;padding-top:13px;text-align:center}@media print{.invoice-sheet{padding:0}}</style>`;

  function renderLeadOptions() {
    const select = document.getElementById('crm-invoice-lead');
    const selected = select.value;
    select.innerHTML = `<option value="">Choose a CRM lead...</option>${leads.map((lead) => `<option value="${escapeHtml(lead.id)}">${escapeHtml(lead.name || 'Unnamed lead')} · ${escapeHtml(lead.email || '')}</option>`).join('')}`;
    if (leads.some((lead) => lead.id === selected)) select.value = selected;
  }

  function renderSavedInvoices() {
    document.getElementById('crm-invoice-count').textContent = invoices.length ? `${invoices.length} saved` : '';
    invoiceList.innerHTML = invoices.length ? invoices.map((invoice) => `<button type="button" data-saved-invoice="${escapeHtml(invoice.id)}" class="w-full text-left rounded-xl border border-gray-100 bg-[#F8FAFB] p-4 hover:border-[#00C2D1] transition-colors"><span class="flex items-center justify-between gap-2"><span class="font-semibold text-[#0B0B0B]">${escapeHtml(invoice.invoice_number)}</span><span class="text-xs font-semibold ${invoice.status === 'sent' ? 'text-[#008C99]' : 'text-[#6C797C]'}">${escapeHtml(label(invoice.status || 'draft'))}</span></span><span class="block text-sm text-[#3C494C] mt-1">${escapeHtml(invoice.customer?.name || '')}</span><span class="block text-xs text-[#6C797C] mt-2">${escapeHtml(formatDate(invoice.issue_date))} · ${formatMoney(invoice.subtotal ?? invoiceTotal(invoice))}</span></button>`).join('') : '<p class="text-sm text-[#6C797C]">Invoices you save will appear here.</p>';
  }

  async function loadInvoices() {
    const result = await request('list_invoices');
    invoices = Array.isArray(result.invoices) ? result.invoices : [];
    renderSavedInvoices();
  }

  function newInvoice(prefill = {}) {
    const issueDate = prefill.issue_date || today();
    invoiceForm.reset();
    document.getElementById('crm-invoice-id').value = prefill.id || '';
    document.getElementById('crm-invoice-number').value = prefill.invoice_number || `SS-${new Date().getFullYear()}-${String(invoices.length + 1).padStart(3, '0')}`;
    document.getElementById('crm-invoice-issue-date').value = issueDate;
    document.getElementById('crm-invoice-due-date').value = prefill.due_date || addDays(issueDate, 7);
    document.getElementById('crm-invoice-service-date').value = prefill.service_date || '';
    document.getElementById('crm-invoice-payment-link').value = prefill.payment_link || '';
    document.getElementById('crm-invoice-customer-name').value = prefill.customer?.name || '';
    document.getElementById('crm-invoice-customer-email').value = prefill.customer?.email || '';
    document.getElementById('crm-invoice-customer-phone').value = prefill.customer?.phone || '';
    document.getElementById('crm-invoice-customer-postcode').value = prefill.customer?.postcode || '';
    document.getElementById('crm-invoice-customer-address').value = prefill.customer?.address || '';
    document.getElementById('crm-invoice-notes').value = prefill.notes || '';
    invoiceItems.innerHTML = '';
    (prefill.line_items?.length ? prefill.line_items : [{ description: prefill.service || 'Cleaning services', quantity: 1, unit_price: '' }]).forEach(addInvoiceItemRow);
    setInvoiceStatus(prefill.status || 'draft');
    document.getElementById('crm-invoice-message').textContent = '';
    renderInvoicePreview();
  }

  function openSavedInvoice(invoice) {
    newInvoice(invoice);
    invoicePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function openInvoicePrint(invoice = getInvoiceFromForm()) {
    const printWindow = window.open('', '_blank');
    if (!printWindow) {
      document.getElementById('crm-invoice-message').textContent = 'Please allow pop-ups to generate the PDF preview.';
      return;
    }
    printWindow.document.write(`<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><title>${escapeHtml(invoice.invoice_number || 'Sanctuary Shine invoice')}</title>${invoicePrintStyles}</head><body>${invoiceMarkup(invoice)}</body></html>`);
    printWindow.document.close();
    printWindow.focus();
    setTimeout(() => printWindow.print(), 350);
  }

  function invoiceMailto(invoice) {
    const lines = (invoice.line_items || []).map((item) => `${item.quantity} x ${item.description} - ${formatMoney(Number(item.quantity || 0) * Number(item.unit_price || 0))}`).join('\n');
    const body = `Hi ${invoice.customer.name},\n\nPlease find your Sanctuary Shine invoice ${invoice.invoice_number}.\n\n${lines}\n\nTotal due: ${formatMoney(invoiceTotal(invoice))}\nDue date: ${formatDate(invoice.due_date)}\n\nBank transfer details:\n${invoiceCompany.accountName}\nSort code: ${invoiceCompany.sortCode}\nIBAN: ${invoiceCompany.iban}\nCompany no.: ${invoiceCompany.companyNumber}${invoice.payment_link ? `\n\nPay online: ${invoice.payment_link}` : ''}\n\nThank you,\nSanctuary Shine`;
    window.location.href = `mailto:${encodeURIComponent(invoice.customer.email)}?subject=${encodeURIComponent(`Invoice ${invoice.invoice_number} from Sanctuary Shine`)}&body=${encodeURIComponent(body)}`;
  }

  async function persistInvoice(action = 'save_invoice') {
    const invoice = getInvoiceFromForm();
    const form = new FormData();
    form.set('invoice_json', JSON.stringify(invoice));
    const result = await request(action, { method: 'POST', body: form });
    if (result.invoice) {
      const index = invoices.findIndex((saved) => saved.id === result.invoice.id);
      if (index >= 0) invoices[index] = result.invoice; else invoices.unshift(result.invoice);
      document.getElementById('crm-invoice-id').value = result.invoice.id;
      setInvoiceStatus(result.invoice.status || 'draft');
      renderSavedInvoices();
    }
    return result.invoice || invoice;
  }

  async function loadUsers() {
    const result = await request('users');
    renderUsers(Array.isArray(result.users) ? result.users : []);
  }

  async function loadAccount() {
    const result = await request('me');
    currentUser = result.user;
    document.getElementById('crm-current-user').textContent = `${currentUser.name} · ${currentUser.email}`;
    document.getElementById('crm-logged-in-name').textContent = currentUser.name;
    const loggedInBadge = document.getElementById('crm-logged-in-badge');
    loggedInBadge.classList.remove('hidden');
    loggedInBadge.classList.add('flex');
    document.getElementById('crm-export').classList.toggle('hidden', !hasFeature('export_leads'));
    invoiceToggle.classList.toggle('hidden', !hasFeature('manage_invoices'));
    document.getElementById('crm-detail-invoice').classList.toggle('hidden', !hasFeature('manage_invoices'));
    userManagement.classList.toggle('hidden', !hasFeature('manage_users'));
    document.getElementById('crm-update-form').classList.toggle('hidden', !hasFeature('edit_leads'));
    if (hasFeature('manage_users')) await loadUsers();
    if (hasFeature('manage_invoices')) {
      renderLeadOptions();
      try { await loadInvoices(); } catch (error) { showError(error.message); }
    }
  }

  function renderStats() {
    document.getElementById('stat-total').textContent = leads.length;
    document.getElementById('stat-new').textContent = leads.filter((lead) => lead.status === 'new').length;
    document.getElementById('stat-bookings').textContent = leads.filter((lead) => lead.type === 'booking').length;
    document.getElementById('stat-quotes').textContent = leads.filter((lead) => lead.type === 'quote').length;
  }

  function filteredLeads() {
    const search = document.getElementById('crm-search').value.trim().toLowerCase();
    const type = document.getElementById('crm-type').value;
    const status = document.getElementById('crm-status').value;
    return leads.filter((lead) => {
      const searchable = [lead.name, lead.email, lead.phone, lead.postcode, lead.message].join(' ').toLowerCase();
      return (!search || searchable.includes(search)) && (type === 'all' || lead.type === type) && (status === 'all' || lead.status === status);
    });
  }

  function renderLeads() {
    const visibleLeads = filteredLeads();
    leadsBody.innerHTML = visibleLeads.map((lead) => `
      <tr class="hover:bg-[#F8FAFB] cursor-pointer" data-lead-id="${escapeHtml(lead.id)}">
        <td class="px-5 py-4"><p class="font-semibold text-[#0B0B0B]">${escapeHtml(lead.name)}</p><p class="text-xs text-[#6C797C]">${escapeHtml(lead.email)}</p></td>
        <td class="px-5 py-4"><span class="inline-flex px-2.5 py-1 rounded-full bg-[#D9FBFF] text-[#008C99] text-xs font-semibold">${escapeHtml(label(lead.type))}</span></td>
        <td class="px-5 py-4 text-[#3C494C]">${escapeHtml(formatDate(lead.preferred_date))}</td>
        <td class="px-5 py-4"><span class="text-xs font-semibold">${escapeHtml(label(lead.status))}</span></td>
        <td class="px-5 py-4 text-[#6C797C] whitespace-nowrap">${escapeHtml(formatDate(lead.created_at))}</td>
        <td class="px-5 py-4 text-right text-[#008C99]">View</td>
      </tr>`).join('');
    leadsCards.innerHTML = visibleLeads.map((lead) => `
      <button type="button" data-lead-id="${escapeHtml(lead.id)}" class="w-full text-left rounded-xl border border-gray-100 bg-[#F8FAFB] p-4 active:bg-[#EAF7F8] transition-colors">
        <span class="flex items-start justify-between gap-3">
          <span class="min-w-0"><span class="block truncate font-semibold text-[#0B0B0B]">${escapeHtml(lead.name || 'Unnamed lead')}</span><span class="block truncate text-xs text-[#6C797C] mt-1">${escapeHtml(lead.email || '')}</span></span>
          <span class="shrink-0 inline-flex px-2.5 py-1 rounded-full bg-[#D9FBFF] text-[#008C99] text-xs font-semibold">${escapeHtml(label(lead.type))}</span>
        </span>
        <span class="grid grid-cols-2 gap-3 mt-4 pt-3 border-t border-gray-200">
          <span><span class="block text-[10px] uppercase tracking-wider text-[#6C797C]">Preferred date</span><span class="block text-sm text-[#3C494C] mt-1">${escapeHtml(formatDate(lead.preferred_date))}</span></span>
          <span><span class="block text-[10px] uppercase tracking-wider text-[#6C797C]">Status</span><span class="block text-sm font-semibold text-[#0B0B0B] mt-1">${escapeHtml(label(lead.status))}</span></span>
        </span>
        <span class="flex items-center justify-between gap-3 mt-3 text-xs"><span class="text-[#6C797C]">Received ${escapeHtml(formatDate(lead.created_at))}</span><span class="shrink-0 font-semibold text-[#008C99]">View details</span></span>
      </button>`).join('');
    emptyState.classList.toggle('hidden', visibleLeads.length !== 0);
  }

  function openDetail(lead) {
    selectedLead = lead;
    document.getElementById('crm-detail-name').textContent = lead.name || 'Unnamed lead';
    document.getElementById('crm-detail-contact').innerHTML = `${escapeHtml(lead.email)}${lead.phone ? ` · ${escapeHtml(lead.phone)}` : ''} · Received ${escapeHtml(formatDateTime(lead.created_at))}`;
    document.getElementById('crm-detail-summary').innerHTML = [
      ['Type', label(lead.type)], ['Postcode', lead.postcode || '—'], ['Preferred date', formatDate(lead.preferred_date)],
      ['Cleaning type', label(lead.cleaning_type) || '—'], ['Property', label(lead.property_type) || '—'], ['Email delivery', label(lead.email_status) || '—']
    ].map(([heading, value]) => `<div class="min-w-0 border border-gray-100 rounded-lg p-3"><p class="text-xs text-[#6C797C]">${escapeHtml(heading)}</p><p class="font-semibold mt-1 break-words">${escapeHtml(value)}</p></div>`).join('');
    document.getElementById('crm-detail-id').value = lead.id;
    document.getElementById('crm-detail-name-input').value = lead.name || '';
    document.getElementById('crm-detail-email').value = lead.email || '';
    document.getElementById('crm-detail-phone').value = lead.phone || '';
    document.getElementById('crm-detail-postcode').value = lead.postcode || '';
    document.getElementById('crm-detail-subject').value = lead.subject || '';
    document.getElementById('crm-detail-cleaning-type').value = lead.cleaning_type || '';
    document.getElementById('crm-detail-property-type').value = lead.property_type || '';
    document.getElementById('crm-detail-size').value = lead.size || '';
    document.getElementById('crm-detail-preferred-date').value = lead.preferred_date || '';
    document.getElementById('crm-detail-status').value = lead.status || 'new';
    document.getElementById('crm-detail-notes').value = lead.notes || '';
    document.getElementById('crm-detail-message-input').value = lead.message || '';
    detail.classList.remove('hidden');
    detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function loadLeads() {
    leadLoadStatus.textContent = 'Loading leads...';
    refreshLeadsButton.disabled = true;
    try {
      const result = await request('list');
      if (!Array.isArray(result.leads)) throw new Error('The CRM returned an invalid leads response. Please refresh and try again.');
      // A transient empty response must not wipe a list that is already on screen.
      // The API is the source of truth, but an empty result after a successful
      // load is treated as a failed refresh and the current list is retained.
      if (result.leads.length === 0 && leads.length > 0) {
        leadLoadStatus.textContent = `${leads.length} lead${leads.length === 1 ? '' : 's'} available (refresh retained)`;
        return;
      }
      leads = result.leads;
      leadsLoaded = true;
      errorBox.classList.add('hidden');
      renderStats();
      renderLeads();
      renderLeadOptions();
      leadLoadStatus.textContent = `${leads.length} lead${leads.length === 1 ? '' : 's'} available`;
    } catch (error) {
      leadLoadStatus.textContent = 'Unable to load leads';
      throw error;
    } finally {
      refreshLeadsButton.disabled = false;
    }
  }

  async function showDashboard() {
    if (dashboardReady) return;
    if (dashboardLoadPromise) return dashboardLoadPromise;
    loginPanel.classList.add('hidden');
    dashboard.classList.add('hidden');
    dashboardLoadPromise = (async () => {
      try {
        await loadLeads();
        if (!leadsLoaded) throw new Error('The CRM could not confirm the lead list. Please sign in again.');
        dashboard.classList.remove('hidden');
        try { await loadAccount(); } catch (error) { showError(error.message); }
        dashboardReady = true;
      } catch (error) {
        dashboard.classList.add('hidden');
        loginPanel.classList.remove('hidden');
        loginMessage.textContent = error.message || 'The CRM could not load your leads. Please sign in again.';
      }
    })();
    try { await dashboardLoadPromise; } finally { dashboardLoadPromise = null; }
  }

  loginForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    loginMessage.textContent = '';
    const button = loginForm.querySelector('button');
    button.disabled = true;
    try {
      const result = await request('login', { method: 'POST', body: new FormData(loginForm) });
      currentUser = result.user;
      loginForm.reset();
      await showDashboard();
    } catch (error) {
      loginMessage.textContent = error.message;
    } finally { button.disabled = false; }
  });

  leadsBody.addEventListener('click', (event) => {
    const row = event.target.closest('[data-lead-id]');
    if (row) openDetail(leads.find((lead) => lead.id === row.dataset.leadId));
  });
  leadsCards.addEventListener('click', (event) => {
    const card = event.target.closest('[data-lead-id]');
    if (card) openDetail(leads.find((lead) => lead.id === card.dataset.leadId));
  });

  ['crm-search', 'crm-type', 'crm-status'].forEach((id) => document.getElementById(id).addEventListener('input', renderLeads));
  refreshLeadsButton.addEventListener('click', async () => {
    try { await loadLeads(); } catch (error) { refreshLeadsButton.disabled = false; leadLoadStatus.textContent = 'Unable to load leads'; showError(error.message); }
  });
  document.getElementById('crm-reset-lead-filters').addEventListener('click', () => {
    document.getElementById('crm-search').value = '';
    document.getElementById('crm-type').value = 'all';
    document.getElementById('crm-status').value = 'all';
    renderLeads();
  });
  document.getElementById('crm-detail-close').addEventListener('click', () => detail.classList.add('hidden'));

  accountToggle.addEventListener('click', () => accountPanel.classList.toggle('hidden'));

  invoiceToggle.addEventListener('click', () => {
    invoicePanel.classList.toggle('hidden');
    if (!invoicePanel.classList.contains('hidden') && !document.getElementById('crm-invoice-number').value) newInvoice();
    if (!invoicePanel.classList.contains('hidden')) invoicePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('crm-invoice-new').addEventListener('click', () => newInvoice());
  document.getElementById('crm-invoice-saved').addEventListener('click', () => savedInvoicesPanel.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  document.getElementById('crm-invoice-add-item').addEventListener('click', () => { addInvoiceItemRow(); renderInvoicePreview(); });
  document.getElementById('crm-invoice-lead').addEventListener('change', (event) => {
    const lead = leads.find((candidate) => candidate.id === event.target.value);
    if (!lead) return;
    document.getElementById('crm-invoice-customer-name').value = lead.name || '';
    document.getElementById('crm-invoice-customer-email').value = lead.email || '';
    document.getElementById('crm-invoice-customer-phone').value = lead.phone || '';
    document.getElementById('crm-invoice-customer-postcode').value = lead.postcode || '';
    document.getElementById('crm-invoice-service-date').value = lead.preferred_date || '';
    const firstItem = invoiceItems.querySelector('[data-item-description]');
    if (firstItem && !firstItem.value) firstItem.value = lead.cleaning_type ? label(lead.cleaning_type) : 'Cleaning services';
    renderInvoicePreview();
  });
  invoiceItems.addEventListener('click', (event) => {
    if (!event.target.closest('[data-remove-invoice-item]')) return;
    const rows = invoiceItems.querySelectorAll('[data-invoice-item]');
    if (rows.length > 1) event.target.closest('[data-invoice-item]').remove();
    renderInvoicePreview();
  });
  invoiceForm.addEventListener('input', renderInvoicePreview);
  invoiceForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = document.getElementById('crm-invoice-message');
    message.className = 'text-sm min-h-5';
    if (!invoiceForm.reportValidity()) return;
    try {
      const saved = await persistInvoice('save_invoice');
      message.textContent = `Invoice ${saved.invoice_number} saved to the CRM.`;
      message.classList.add('text-green-600');
    } catch (error) {
      message.textContent = error.message;
      message.classList.add('text-red-600');
    }
  });
  document.getElementById('crm-invoice-pdf').addEventListener('click', () => {
    if (!invoiceForm.reportValidity()) return;
    openInvoicePrint();
  });
  document.getElementById('crm-invoice-send').addEventListener('click', async () => {
    const message = document.getElementById('crm-invoice-message');
    message.className = 'text-sm min-h-5';
    if (!invoiceForm.reportValidity()) return;
    try {
      const sent = await persistInvoice('send_invoice');
      message.textContent = sent.email_status === 'sent' ? `Invoice sent to ${sent.customer.email}.` : 'Invoice saved.';
      message.classList.add('text-green-600');
    } catch (error) {
      message.textContent = 'Server email delivery is unavailable. You can send it from your email app instead.';
      message.classList.add('text-red-600');
      if (window.confirm('Open your email app with this invoice prepared?')) invoiceMailto(getInvoiceFromForm());
    }
  });
  document.getElementById('crm-invoice-share').addEventListener('click', async () => {
    const invoice = getInvoiceFromForm();
    const message = document.getElementById('crm-invoice-message');
    if (!invoice.payment_link) {
      message.textContent = 'Add a payment link first, then share it with the customer.';
      message.className = 'text-sm min-h-5 text-red-600';
      return;
    }
    try {
      if (navigator.share) await navigator.share({ title: `Payment for ${invoiceCompany.name}`, text: `Payment link for invoice ${invoice.invoice_number}`, url: invoice.payment_link });
      else if (navigator.clipboard) await navigator.clipboard.writeText(invoice.payment_link);
      else window.prompt('Copy this payment link', invoice.payment_link);
      message.textContent = navigator.share ? 'Payment link shared.' : 'Payment link copied to your clipboard.';
      message.className = 'text-sm min-h-5 text-green-600';
    } catch (error) {
      if (error.name !== 'AbortError') { message.textContent = 'Payment link could not be shared.'; message.className = 'text-sm min-h-5 text-red-600'; }
    }
  });
  invoiceList.addEventListener('click', (event) => {
    const button = event.target.closest('[data-saved-invoice]');
    if (!button) return;
    const invoice = invoices.find((saved) => saved.id === button.dataset.savedInvoice);
    if (invoice) openSavedInvoice(invoice);
  });
  document.getElementById('crm-detail-invoice').addEventListener('click', () => {
    if (!selectedLead) return;
    newInvoice({ customer: { name: selectedLead.name, email: selectedLead.email, phone: selectedLead.phone, postcode: selectedLead.postcode }, service_date: selectedLead.preferred_date, service: selectedLead.cleaning_type ? label(selectedLead.cleaning_type) : 'Cleaning services' });
    invoicePanel.classList.remove('hidden');
    invoicePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-password-toggle]');
    if (!button) return;
    const input = document.getElementById(button.dataset.passwordToggle);
    if (!input) return;
    input.type = input.type === 'password' ? 'text' : 'password';
    button.textContent = input.type === 'password' ? 'Show' : 'Hide';
  });

  document.getElementById('crm-password-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = document.getElementById('crm-password-message');
    const currentPassword = document.getElementById('crm-current-password').value;
    const newPassword = document.getElementById('crm-new-password').value;
    const confirmation = document.getElementById('crm-confirm-password').value;
    message.className = 'text-sm min-h-5';
    if (newPassword !== confirmation) {
      message.textContent = 'The new passwords do not match.';
      message.classList.add('text-red-600');
      return;
    }
    try {
      const form = new FormData();
      form.set('current_password', currentPassword);
      form.set('new_password', newPassword);
      const result = await request('change_password', { method: 'POST', body: form });
      message.textContent = result.message || 'Password changed.';
      message.classList.add('text-green-600');
      event.target.reset();
    } catch (error) {
      message.textContent = error.message;
      message.classList.add('text-red-600');
    }
  });

  document.getElementById('crm-create-user-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = document.getElementById('crm-user-message');
    message.className = 'text-sm min-h-5';
    const form = new FormData();
    form.set('name', document.getElementById('crm-new-user-name').value);
    form.set('email', document.getElementById('crm-new-user-email').value);
    form.set('password', document.getElementById('crm-new-user-password').value);
    document.querySelectorAll('[data-create-feature]:checked').forEach((checkbox) => form.append('features[]', checkbox.value));
    try {
      await request('create_user', { method: 'POST', body: form });
      message.textContent = 'User added successfully.';
      message.classList.add('text-green-600');
      event.target.reset();
      await loadUsers();
    } catch (error) {
      message.textContent = error.message;
      message.classList.add('text-red-600');
    }
  });

  usersList.addEventListener('click', async (event) => {
    const card = event.target.closest('[data-crm-user-id]');
    if (!card) return;
    const userId = card.dataset.crmUserId;
    const message = document.getElementById('crm-user-message');
    message.className = 'text-sm min-h-5';
    if (event.target.closest('[data-user-save]')) {
      const form = new FormData();
      form.set('user_id', userId);
      form.set('name', card.querySelector('[data-user-name]').value);
      form.set('email', card.querySelector('[data-user-email]').value);
      form.set('active', card.querySelector('[data-user-active]').checked ? '1' : '0');
      const newPassword = card.querySelector('[data-user-password]').value;
      if (newPassword) form.set('password', newPassword);
      card.querySelectorAll('[data-user-feature]:checked').forEach((checkbox) => form.append('features[]', checkbox.dataset.userFeature));
      try {
        await request('update_user', { method: 'POST', body: form });
        message.textContent = 'User access updated.';
        message.classList.add('text-green-600');
        await loadUsers();
      } catch (error) {
        message.textContent = error.message;
        message.classList.add('text-red-600');
      }
    }
    if (event.target.closest('[data-user-delete]')) {
      if (!window.confirm('Remove this CRM user?')) return;
      const form = new FormData();
      form.set('user_id', userId);
      try {
        await request('delete_user', { method: 'POST', body: form });
        message.textContent = 'User removed.';
        message.classList.add('text-green-600');
        await loadUsers();
      } catch (error) {
        message.textContent = error.message;
        message.classList.add('text-red-600');
      }
    }
  });

  document.getElementById('crm-update-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selectedLead) return;
    const selectedId = selectedLead.id;
    const form = new FormData();
    form.set('id', selectedId);
    form.set('name', document.getElementById('crm-detail-name-input').value);
    form.set('email', document.getElementById('crm-detail-email').value);
    form.set('phone', document.getElementById('crm-detail-phone').value);
    form.set('postcode', document.getElementById('crm-detail-postcode').value);
    form.set('subject', document.getElementById('crm-detail-subject').value);
    form.set('cleaning_type', document.getElementById('crm-detail-cleaning-type').value);
    form.set('property_type', document.getElementById('crm-detail-property-type').value);
    form.set('size', document.getElementById('crm-detail-size').value);
    form.set('preferred_date', document.getElementById('crm-detail-preferred-date').value);
    form.set('message', document.getElementById('crm-detail-message-input').value);
    form.set('status', document.getElementById('crm-detail-status').value);
    form.set('notes', document.getElementById('crm-detail-notes').value);
    try {
      await request('update', { method: 'POST', body: form });
      await loadLeads();
      selectedLead = leads.find((lead) => lead.id === selectedId);
      if (selectedLead) openDetail(selectedLead);
    } catch (error) { showError(error.message); }
  });

  document.getElementById('crm-logout').addEventListener('click', async () => {
    await request('logout', { method: 'POST' });
    currentUser = null;
    leadsLoaded = false;
    dashboardReady = false;
    accountPanel.classList.add('hidden');
    dashboard.classList.add('hidden');
    loginPanel.classList.remove('hidden');
    const loggedInBadge = document.getElementById('crm-logged-in-badge');
    loggedInBadge.classList.add('hidden');
    loggedInBadge.classList.remove('flex');
  });

  document.getElementById('crm-export').addEventListener('click', async () => {
    try {
      const response = await fetch(`${api}?action=export`);
      if (!response.ok) throw new Error('Could not export leads.');
      const blob = await response.blob();
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'sanctuary-shine-crm.csv';
      link.click();
      URL.revokeObjectURL(link.href);
    } catch (error) { showError(error.message); }
  });

  document.getElementById('crm-forgot-link').addEventListener('click', () => {
    loginPanel.classList.add('hidden');
    forgotPanel.classList.remove('hidden');
  });

  document.getElementById('crm-forgot-back').addEventListener('click', () => {
    forgotPanel.classList.add('hidden');
    loginPanel.classList.remove('hidden');
  });

  forgotForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = document.getElementById('crm-forgot-message');
    message.className = 'text-sm min-h-5';
    const button = forgotForm.querySelector('button');
    button.disabled = true;
    try {
      const form = new FormData();
      form.set('email', document.getElementById('crm-forgot-email').value);
      const result = await request('request_password_reset', { method: 'POST', body: form });
      message.textContent = result.message || 'If that email has a CRM account, a reset link has been sent.';
      message.classList.add('text-green-600');
      forgotForm.reset();
    } catch (error) {
      message.textContent = error.message;
      message.classList.add('text-red-600');
    } finally { button.disabled = false; }
  });

  resetForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = document.getElementById('crm-reset-message');
    message.className = 'text-sm min-h-5';
    const newPassword = document.getElementById('crm-reset-new-password').value;
    const confirmation = document.getElementById('crm-reset-confirm-password').value;
    if (newPassword !== confirmation) {
      message.textContent = 'The new passwords do not match.';
      message.classList.add('text-red-600');
      return;
    }
    const button = resetForm.querySelector('button');
    button.disabled = true;
    try {
      const form = new FormData();
      form.set('token', new URLSearchParams(window.location.search).get('reset_token') || '');
      form.set('new_password', newPassword);
      const result = await request('reset_password', { method: 'POST', body: form });
      message.textContent = result.message || 'Your password has been reset.';
      message.classList.add('text-green-600');
      resetForm.reset();
      window.history.replaceState({}, '', window.location.pathname);
      setTimeout(() => {
        resetPanel.classList.add('hidden');
        loginPanel.classList.remove('hidden');
      }, 1500);
    } catch (error) {
      message.textContent = error.message;
      message.classList.add('text-red-600');
    } finally { button.disabled = false; }
  });

  // Some browsers restore the last-used value of unnamed search/select fields on a
  // plain reload, sometimes after this script has already run. That silently
  // re-applies an old filter once the leads have rendered, making a full list
  // flash briefly before appearing to "hide" down to a filtered subset. Force
  // these back to their neutral defaults on every load so a stale restored
  // filter can never mask freshly loaded leads.
  const resetLeadFilters = () => {
    document.getElementById('crm-search').value = '';
    document.getElementById('crm-type').value = 'all';
    document.getElementById('crm-status').value = 'all';
    renderLeads();
  };
  resetLeadFilters();
  window.addEventListener('pageshow', resetLeadFilters);

  const resetToken = new URLSearchParams(window.location.search).get('reset_token');
  newInvoice();
  if (resetToken) {
    loginPanel.classList.add('hidden');
    resetPanel.classList.remove('hidden');
  } else {
    request('session').then((result) => { if (result.authenticated) { currentUser = result.user; showDashboard(); } }).catch(() => {});
  }

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/crm-sw.js?v=6', { scope: '/crm/' }).catch(() => {});
    navigator.serviceWorker.addEventListener('controllerchange', () => window.location.reload());
  }

  let installPrompt = null;
  const installButton = document.getElementById('crm-install-button');
  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installPrompt = event;
    installButton.classList.remove('hidden');
    installButton.classList.add('flex');
  });
  installButton.addEventListener('click', async () => {
    if (!installPrompt) return;
    installPrompt.prompt();
    await installPrompt.userChoice;
    installPrompt = null;
    installButton.classList.add('hidden');
    installButton.classList.remove('flex');
  });
  window.addEventListener('appinstalled', () => {
    installButton.classList.add('hidden');
    installButton.classList.remove('flex');
  });
</script>
